# 必填：Discord Developer Portal -> Bot
DISCORD_TOKEN=

# Sub2API AI 聊天。留空时行情功能仍可使用。
AI_API_KEY=
# 填你的 Sub2API 实例地址，通常以 /v1 结尾；不要填写具体接口路径。
AI_BASE_URL=https://your-sub2api-domain.example/v1
# 必须是你的 Sub2API 控制台中可用的模型名。
AI_MODEL=gpt-5-mini
# chat_completions 兼容面更广；实例明确支持 /responses 时可改为 responses。
AI_API_MODE=chat_completions

# CoinGecko Demo API Key（推荐）
COINGECKO_API_KEY=

# /gas 指令需要
ETHERSCAN_API_KEY=

# 可选
DATABASE_PATH=data/crypto_bot.db
LOG_LEVEL=INFO
